+package main
+
+/*
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct {
+	void* ptr;
+	size_t len;
+} cliproxy_buffer;
+
+typedef struct {
+	uint32_t abi_version;
+	void* host_ctx;
+	void* call;
+	void* free_buffer;
+} cliproxy_host_api;
+
+typedef int (*cliproxy_plugin_call_fn)(char*, uint8_t*, size_t, cliproxy_buffer*);
+typedef void (*cliproxy_plugin_free_fn)(void*, size_t);
+typedef void (*cliproxy_plugin_shutdown_fn)(void);
+
+typedef struct {
+	uint32_t abi_version;
+	cliproxy_plugin_call_fn call;
+	cliproxy_plugin_free_fn free_buffer;
+	cliproxy_plugin_shutdown_fn shutdown;
+} cliproxy_plugin_api;
+
+extern int cliproxyPluginCall(char*, uint8_t*, size_t, cliproxy_buffer*);
+extern void cliproxyPluginFree(void*, size_t);
+extern void cliproxyPluginShutdown(void);
+*/
+import "C"
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"regexp"
+	"unsafe"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginabi"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+)
+
+// devinToolIDPrefix is the namespace CLIProxyAPI reserves for tool-call IDs it
+// synthesises for the Devin executor. Those IDs persist in client history and
+// strict upstreams reject them once the session routes to another provider.
+const devinToolIDPrefix = "cpa_tid_v1_"
+
+var encodedToolIDPattern = regexp.MustCompile(`"` + devinToolIDPrefix + `[A-Za-z0-9_-]+"`)
+
+type envelope struct {
+	OK     bool            `json:"ok"`
+	Result json.RawMessage `json:"result,omitempty"`
+	Error  *envelopeError  `json:"error,omitempty"`
+}
+
+type envelopeError struct {
+	Code    string `json:"code"`
+	Message string `json:"message"`
+}
+
+type registration struct {
+	SchemaVersion uint32                 `json:"schema_version"`
+	Metadata      pluginapi.Metadata     `json:"metadata"`
+	Capabilities  registrationCapability `json:"capabilities"`
+}
+
+type registrationCapability struct {
+	RequestInterceptor bool `json:"request_interceptor"`
+}
+
+type interceptRequest struct {
+	RequestID string `json:"RequestID"`
+	// Body arrives base64-encoded because the host marshals []byte.
+	Body []byte `json:"Body"`
+}
+
+func main() {}
+
+//export cliproxy_plugin_init
+func cliproxy_plugin_init(_ *C.cliproxy_host_api, plugin *C.cliproxy_plugin_api) C.int {
+	if plugin == nil {
+		return 1
+	}
+	plugin.abi_version = C.uint32_t(pluginabi.ABIVersion)
+	plugin.call = C.cliproxy_plugin_call_fn(C.cliproxyPluginCall)
+	plugin.free_buffer = C.cliproxy_plugin_free_fn(C.cliproxyPluginFree)
+	plugin.shutdown = C.cliproxy_plugin_shutdown_fn(C.cliproxyPluginShutdown)
+	return 0
+}
+
+//export cliproxyPluginCall
+func cliproxyPluginCall(method *C.char, request *C.uint8_t, requestLen C.size_t, response *C.cliproxy_buffer) C.int {
+	if response != nil {
+		response.ptr = nil
+		response.len = 0
+	}
+	if method == nil {
+		writeResponse(response, errorEnvelope("invalid_method", "method is required"))
+		return 1
+	}
+	var requestBytes []byte
+	if request != nil && requestLen > 0 {
+		requestBytes = C.GoBytes(unsafe.Pointer(request), C.int(requestLen))
+	}
+	raw, errHandle := handleMethod(C.GoString(method), requestBytes)
+	if errHandle != nil {
+		writeResponse(response, errorEnvelope("plugin_error", errHandle.Error()))
+		return 1
+	}
+	writeResponse(response, raw)
+	return 0
+}
+
+//export cliproxyPluginFree
+func cliproxyPluginFree(ptr unsafe.Pointer, _ C.size_t) {
+	if ptr != nil {
+		C.free(ptr)
+	}
+}
+
+//export cliproxyPluginShutdown
+func cliproxyPluginShutdown() {}
+
+func handleMethod(method string, request []byte) ([]byte, error) {
+	switch method {
+	case pluginabi.MethodPluginRegister, pluginabi.MethodPluginReconfigure:
+		return okEnvelope(pluginRegistration())
+	case pluginabi.MethodRequestInterceptBefore, pluginabi.MethodRequestInterceptAfter:
+		return intercept(request)
+	default:
+		return errorEnvelope("unknown_method", "unknown method: "+method), nil
+	}
+}
+
+func pluginRegistration() registration {
+	return registration{
+		SchemaVersion: pluginabi.SchemaVersion,
+		Metadata: pluginapi.Metadata{
+			Name:             "tool-id-normalizer",
+			Version:          "0.2.0",
+			Author:           "deptrai",
+			GitHubRepository: "https://github.com/deptrai/CLIProxyAPI",
+		},
+		Capabilities: registrationCapability{RequestInterceptor: true},
+	}
+}
+
+// intercept rewrites reserved tool-call IDs into unique portable toolu_* IDs.
+// The mapping is derived from the original ID so an assistant tool call and its
+// matching tool result always land on the same value.
+func intercept(raw []byte) ([]byte, error) {
+	var req interceptRequest
+	if len(raw) > 0 {
+		if errUnmarshal := json.Unmarshal(raw, &req); errUnmarshal != nil {
+			return nil, errUnmarshal
+		}
+	}
+	if len(req.Body) == 0 {
+		return okEnvelope(pluginapi.RequestInterceptResponse{})
+	}
+	body := req.Body
+	if !encodedToolIDPattern.Match(body) {
+		return okEnvelope(pluginapi.RequestInterceptResponse{})
+	}
+	rewritten := encodedToolIDPattern.ReplaceAllFunc(body, func(match []byte) []byte {
+		original := string(match[1 : len(match)-1])
+		return []byte(`"` + portableToolID(original) + `"`)
+	})
+	return okEnvelope(pluginapi.RequestInterceptResponse{Body: rewritten})
+}
+
+func portableToolID(id string) string {
+	sum := sha256.Sum256([]byte(id))
+	return "toolu_" + hex.EncodeToString(sum[:])[:24]
+}
+
+func okEnvelope(v any) ([]byte, error) {
+	raw, errMarshal := json.Marshal(v)
+	if errMarshal != nil {
+		return nil, errMarshal
+	}
+	return json.Marshal(envelope{OK: true, Result: raw})
+}
+
+func errorEnvelope(code, message string) []byte {
+	raw, _ := json.Marshal(envelope{OK: false, Error: &envelopeError{Code: code, Message: message}})
+	return raw
+}
+
+func writeResponse(response *C.cliproxy_buffer, raw []byte) {
+	if response == nil || len(raw) == 0 {
+		return
+	}
+	ptr := C.CBytes(raw)
+	if ptr == nil {
+		return
+	}
+	response.ptr = ptr
+	response.len = C.size_t(len(raw))
+}
diff --git a/examples/plugin/tool-id-normalizer/go/main_test.go b/examples/plugin/tool-id-normalizer/go/main_test.go
new file mode 100644
index 00000000..5ebfdb9f
--- /dev/null
+++ b/examples/plugin/tool-id-normalizer/go/main_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func interceptBody(t *testing.T, body string) string {
+	t.Helper()
+	raw, errMarshal := json.Marshal(map[string]any{"RequestID": "r1", "Body": []byte(body)})
+	if errMarshal != nil {
+		t.Fatalf("marshal: %v", errMarshal)
+	}
+	out, err := intercept(raw)
+	if err != nil {
+		t.Fatalf("intercept: %v", err)
+	}
+	var env envelope
+	if errUnmarshal := json.Unmarshal(out, &env); errUnmarshal != nil {
+		t.Fatalf("envelope: %v", errUnmarshal)
+	}
+	if !env.OK {
+		t.Fatalf("not ok: %s", out)
+	}
+	var resp struct{ Body []byte }
+	if errUnmarshal := json.Unmarshal(env.Result, &resp); errUnmarshal != nil {
+		t.Fatalf("result: %v", errUnmarshal)
+	}
+	return string(resp.Body)
+}
+
+func TestReservedToolIDsBecomeUniquePortableIDs(t *testing.T) {
+	body := `{"messages":[
+		{"role":"assistant","content":[{"type":"tool_use","id":"cpa_tid_v1_AAA","name":"Bash","input":{}}]},
+		{"role":"user","content":[{"type":"tool_result","tool_use_id":"cpa_tid_v1_AAA","content":"ok"}]},
+		{"role":"assistant","content":[{"type":"tool_use","id":"cpa_tid_v1_BBB","name":"Read","input":{}}]},
+		{"role":"user","content":[{"type":"tool_result","tool_use_id":"cpa_tid_v1_BBB","content":"ok"}]}
+	]}`
+	got := interceptBody(t, body)
+	if strings.Contains(got, "cpa_tid_v1_") {
+		t.Fatalf("reserved prefix survived: %s", got)
+	}
+	var parsed struct {
+		Messages []struct {
+			Content []struct {
+				ID        string `json:"id"`
+				ToolUseID string `json:"tool_use_id"`
+			} `json:"content"`
+		} `json:"messages"`
+	}
+	if err := json.Unmarshal([]byte(got), &parsed); err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	a, b := parsed.Messages[0].Content[0].ID, parsed.Messages[2].Content[0].ID
+	if a != parsed.Messages[1].Content[0].ToolUseID {
+		t.Fatalf("pair 1 diverged: %q vs %q", a, parsed.Messages[1].Content[0].ToolUseID)
+	}
+	if b != parsed.Messages[3].Content[0].ToolUseID {
+		t.Fatalf("pair 2 diverged: %q vs %q", b, parsed.Messages[3].Content[0].ToolUseID)
+	}
+	if a == b {
+		t.Fatalf("distinct ids collapsed to one value: %q", a)
+	}
+	if !strings.HasPrefix(a, "toolu_") || len(a) != len("toolu_")+24 {
+		t.Fatalf("unexpected id shape: %q", a)
+	}
+}
+
+func TestCleanPayloadIsUntouched(t *testing.T) {
+	body := `{"messages":[{"role":"user","content":[{"type":"text","text":"hello"}]}]}`
+	if got := interceptBody(t, body); got != "" {
+		t.Fatalf("expected no rewrite for clean payload, got: %q", got)
+	}
+}
+
+func TestStableMapping(t *testing.T) {
+	body := `{"id":"cpa_tid_v1_AAA"}`
+	first := interceptBody(t, body)
+	second := interceptBody(t, body)
+	if first == "" || first != second {
+		t.Fatalf("mapping not stable: %q vs %q", first, second)
+	}
+}
