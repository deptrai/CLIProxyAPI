+		t.Fatalf("field default = %#v, want preserved default", fields[0].Default)
+	}
 	if fields[0].Description != html.EscapeString(`"quoted" 'single' <b>mode</b>`) {
 		t.Fatalf("description = %q, want escaped", fields[0].Description)
 	}
