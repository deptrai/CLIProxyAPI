--- a/internal/runtime/executor/devin_stream_content_test.go
+++ b/internal/runtime/executor/devin_stream_content_test.go
@@ -324,3 +324,36 @@ func TestDevinStreamContentDoesNotOvertakeQueuedTool(t *testing.T) {
 		})
