From 78f50764a512e66b6eb78676314c5a5033596cda Mon Sep 17 00:00:00 2001
From: Vonic <phanquochoipt@gmail.com>
Date: Wed, 21 Oct 2026 08:48:51 +0700
Subject: [PATCH] fix(executor/devin): filter leaked tool tags and halt
 degenerate tag repetition loops

- Add DevinContentFilter to strip internal tool closing tags (</invoke>, </parameter>, DSML tags) from streaming content deltas.
- Detect degenerate repetition loops of consecutive tag-only chunks (>= 4) and gracefully halt stream with sawEOS to protect client sessions from hanging and runaway token consumption.
- Add unit tests covering filter mechanics, repetition thresholds, and stream termination.
---
 internal/runtime/executor/devin_executor.go   | 27 ++++--
 .../executor/devin_stream_content_test.go     | 33 +++++++
 .../executor/helps/devin_stream_filter.go     | 70 ++++++++++++++
 .../helps/devin_stream_filter_test.go         | 93 +++++++++++++++++++
 4 files changed, 214 insertions(+), 9 deletions(-)
 create mode 100644 internal/runtime/executor/helps/devin_stream_filter.go
 create mode 100644 internal/runtime/executor/helps/devin_stream_filter_test.go

diff --git a/internal/runtime/executor/devin_executor.go b/internal/runtime/executor/devin_executor.go
index 1b8ec84d..0e031f04 100644
--- a/internal/runtime/executor/devin_executor.go
+++ b/internal/runtime/executor/devin_executor.go
@@ -533,6 +533,7 @@ func (e *DevinExecutor) streamDevinFramesForAuth(
 	toolCallCount := 0
 	thinkingBuf := &helps.UTF8SplitBuffer{}
 	contentBuf := &helps.UTF8SplitBuffer{}
+	contentFilter := &helps.DevinContentFilter{}
 	var accumulatedThinking strings.Builder
 	var accumulatedContent strings.Builder
 	var finalUsage *helps.DevinUsage
@@ -1028,19 +1029,27 @@ func (e *DevinExecutor) streamDevinFramesForAuth(
 
 		// Emit content text delta
 		if frameRes.ContentText != "" {
-			accumulatedContent.WriteString(frameRes.ContentText)
 			chunk := contentBuf.Feed([]byte(frameRes.ContentText))
 			if chunk != "" {
-				if thoughtStarted && (!streamContentEarly || len(pendingActions) > 0) {
-					capturedChunk := chunk
-					pendingActions = append(pendingActions, func() bool {
-						return emitContentChunk(capturedChunk)
-					})
-				} else {
-					if !emitContentChunk(chunk) {
-						return
+				cleanChunk, shouldHalt := contentFilter.FilterChunk(chunk)
+				if cleanChunk != "" {
+					accumulatedContent.WriteString(cleanChunk)
+					if thoughtStarted && (!streamContentEarly || len(pendingActions) > 0) {
+						capturedChunk := cleanChunk
+						pendingActions = append(pendingActions, func() bool {
+							return emitContentChunk(capturedChunk)
+						})
+					} else {
+						if !emitContentChunk(cleanChunk) {
+							return
+						}
 					}
 				}
+				if shouldHalt {
+					log.Warnf("devin executor: detected degenerate tool tag repetition loop, halting stream gracefully")
+					sawEOS = true
+					break
+				}
 			}
 		}
 	}
diff --git a/internal/runtime/executor/devin_stream_content_test.go b/internal/runtime/executor/devin_stream_content_test.go
