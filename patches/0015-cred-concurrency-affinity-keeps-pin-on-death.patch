From f3bd3427c92881d49e8120c310ef56d67b708c28 Mon Sep 17 00:00:00 2001
From: Vonic <phanquochoipt@gmail.com>
Date: Fri, 23 Oct 2026 11:22:35 +0700
Subject: [PATCH] fix(plugin): keep affinity pin when the bound credential dies

A dead primary drops out of the candidate list, so the previous code saw the
fallback tier as "top" and rebound the session to it. When the primary
recovered the session stayed on the fallback for the rest of the TTL, which is
how fable traffic silently stopped reaching mmodiary after an outage.

Only create a pin when the session has none; an existing pin is never moved.
A dead primary therefore leaves the session unpinned for that request and it
snaps back as soon as the credential returns. Stale pins still expire via
session_affinity_ttl.
---
 examples/plugin/cred-concurrency/go/main.go   |  8 ++++-
 .../plugin/cred-concurrency/go/main_test.go   | 35 +++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/examples/plugin/cred-concurrency/go/main.go b/examples/plugin/cred-concurrency/go/main.go
index 6a2c4a77..08d512c2 100644
--- a/examples/plugin/cred-concurrency/go/main.go
+++ b/examples/plugin/cred-concurrency/go/main.go
@@ -486,6 +486,7 @@ func pickAuth(raw []byte) ([]byte, error) {
 	// the account holding its cached prefix even when a peer tier exists.
 	bindKey := ""
 	pinnedBusy := false
+	hadBinding := false
 	if cfg.SessionAffinity {
 		sweepBindings(now, cfg.affinityTTL)
 		if sessionID := sessionIdentity(req.Options); sessionID != "" {
@@ -495,6 +496,7 @@ func pickAuth(raw []byte) ([]byte, error) {
 			}
 			bindKey = providerKey + "::" + sessionID + "::" + strings.ToLower(strings.TrimSpace(req.Model))
 			if binding, ok := inflight.bindings[bindKey]; ok {
+				hadBinding = true
 				for _, candidate := range req.Candidates {
 					if candidate.ID != binding.authID {
 						continue
@@ -561,7 +563,11 @@ func pickAuth(raw []byte) ([]byte, error) {
 			if !acquireSlot(candidate, limitFor(cfg, candidate), rotKey, now) {
 				continue
 			}
-			if bindKey != "" && !pinnedBusy && candidate.Priority == topPriority {
+			// Never move an existing pin to another credential: a dead primary
+			// leaves the session unpinned for this request, so it snaps back as
+			// soon as the original credential returns instead of staying on the
+			// fallback for the rest of the TTL. Stale pins expire via affinityTTL.
+			if bindKey != "" && !pinnedBusy && !hadBinding && candidate.Priority == topPriority {
 				inflight.bindings[bindKey] = affinityBinding{authID: candidate.ID, at: now}
 			}
 			return okEnvelope(pluginapi.SchedulerPickResponse{AuthID: candidate.ID, Handled: true})
diff --git a/examples/plugin/cred-concurrency/go/main_test.go b/examples/plugin/cred-concurrency/go/main_test.go
index 28e9c19f..640cd4eb 100644
--- a/examples/plugin/cred-concurrency/go/main_test.go
+++ b/examples/plugin/cred-concurrency/go/main_test.go
@@ -603,3 +603,38 @@ func TestSessionAffinityDoesNotBindFallbackTier(t *testing.T) {
 		t.Fatalf("after recovery picked %s, want top tier 01-cle", next.AuthID)
 	}
 }
+
+func TestSessionAffinityReturnsToPrimaryAfterRecovery(t *testing.T) {
+	// A dead primary drops out of the candidate list. The session must fall back
+	// for that request WITHOUT stealing the pin, so it snaps back to the primary
+	// the moment it recovers instead of sitting on the fallback for the whole TTL.
+	seedAffinityConfig(t, nil)
+	resetInflight(t)
+	primaryOnly := `[
+		{"ID":"mm","Provider":"openai","Priority":30,"Metadata":{"max-concurrent":4}},
+		{"ID":"glm","Provider":"devin","Priority":22,"Metadata":{"max-concurrent":4}}
+	]`
+	fallbackOnly := `[
+		{"ID":"glm","Provider":"devin","Priority":22,"Metadata":{"max-concurrent":4}},
+		{"ID":"swe","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}}
+	]`
+
+	first := pickWithSession(t, primaryOnly, "X-Session-ID", "recover-session")
+	if first.AuthID != "mm" {
+		t.Fatalf("first pick = %s, want primary mm", first.AuthID)
+	}
+	usage(t, first.AuthID)
+
+	// Primary dies: candidates no longer contain it.
+	during := pickWithSession(t, fallbackOnly, "X-Session-ID", "recover-session")
+	if during.AuthID != "glm" {
+		t.Fatalf("during outage picked %s, want fallback glm", during.AuthID)
+	}
+	usage(t, during.AuthID)
+
+	// Primary recovers: the session must return to it, not stay on the fallback.
+	after := pickWithSession(t, primaryOnly, "X-Session-ID", "recover-session")
+	if after.AuthID != "mm" {
+		t.Fatalf("after recovery picked %s, want primary mm again", after.AuthID)
+	}
+}
