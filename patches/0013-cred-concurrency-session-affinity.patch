+				{
+					Name:        "session_affinity",
+					Type:        pluginapi.ConfigFieldTypeBoolean,
+					Description: "Pin each session (and its subagents, via X-Parent-Session-Id) to the credential that served it first so upstream prefix caches stay warm. Default false.",
+				},
+				{
+					Name:        "session_affinity_ttl",
+					Type:        pluginapi.ConfigFieldTypeString,
+					Description: "How long a session-to-credential pin survives without a fresh pick (default 1h).",
+				},
 			},
 		},
 		Capabilities: registrationCapability{
@@ -319,6 +360,97 @@ func sweepStale(now time.Time, ttl time.Duration) {
 	}
 }
 
+// affinitySessionHeaders mirrors the host's session extraction order so a
+// session keeps one identity whether the builtin selector or this plugin picks.
+var affinitySessionHeaders = []string{
+	"X-Claude-Code-Session-Id",
+	"Session-Id",
+	"X-Http-Session-Id",
+	"X-Session-ID",
+	"X-Session-Affinity",
+	"X-Slot-Session-Id",
+}
+
+func headerValue(headers map[string][]string, name string) string {
+	for key, values := range headers {
+		if !strings.EqualFold(key, name) {
+			continue
+		}
+		for _, value := range values {
+			if trimmed := strings.TrimSpace(value); trimmed != "" {
+				return trimmed
+			}
+		}
+	}
+	return ""
+}
+
+// stripSubagentSuffix folds "<parent>:agent:<id>" onto its parent so subagents
+// share the conversation's credential instead of pinning their own.
+func stripSubagentSuffix(sessionID string) string {
+	if idx := strings.Index(sessionID, ":agent:"); idx > 0 {
+		return sessionID[:idx]
+	}
+	return sessionID
+}
+
+// sessionIdentity resolves the affinity key for a request. A subagent's parent
+// session wins over its own ID, matching session-affinity-subagents in the host.
+func sessionIdentity(opts pluginapi.SchedulerOptions) string {
+	if opts.Metadata != nil {
+		if parent, ok := opts.Metadata["parent_session_id"].(string); ok {
+			if trimmed := strings.TrimSpace(parent); trimmed != "" {
+				return stripSubagentSuffix(trimmed)
+			}
+		}
+		if canonical, ok := opts.Metadata["canonical_session_id"].(string); ok {
+			if trimmed := strings.TrimSpace(canonical); trimmed != "" {
+				return stripSubagentSuffix(trimmed)
+			}
+		}
+	}
+	if parent := headerValue(opts.Headers, "X-Parent-Session-Id"); parent != "" {
+		return stripSubagentSuffix(parent)
+	}
+	for _, name := range affinitySessionHeaders {
+		if sessionID := headerValue(opts.Headers, name); sessionID != "" {
+			return stripSubagentSuffix(sessionID)
+		}
+	}
+	return ""
+}
+
+// sweepBindings drops pins that outlived the affinity TTL so a long-dead
+// session cannot keep a credential reserved forever.
+func sweepBindings(now time.Time, ttl time.Duration) {
+	for key, binding := range inflight.bindings {
+		if now.Sub(binding.at) >= ttl {
+			delete(inflight.bindings, key)
+		}
+	}
+}
+
+func acquireSlot(candidate pluginapi.SchedulerAuthCandidate, limit int64, rotKey string, now time.Time) bool {
+	if limit > 0 {
+		if int64(len(inflight.slots[candidate.ID])) >= limit {
+			return false
+		}
+		inflight.slots[candidate.ID] = append(inflight.slots[candidate.ID], now)
+	}
+	if inflight.lastPicked != nil && rotKey != "" {
+		inflight.lastPicked[rotKey] = candidate.ID
+	}
+	return true
+}
+
+func tierRotationKey(candidate pluginapi.SchedulerAuthCandidate) string {
+	rotKey := strconv.Itoa(candidate.Priority)
+	if provider := strings.TrimSpace(candidate.Provider); provider != "" {
+		rotKey = provider + ":" + rotKey
+	}
+	return rotKey
+}
+
 func pickAuth(raw []byte) ([]byte, error) {
 	var req pluginapi.SchedulerPickRequest
 	if errUnmarshal := json.Unmarshal(raw, &req); errUnmarshal != nil {
@@ -350,6 +482,35 @@ func pickAuth(raw []byte) ([]byte, error) {
 	defer inflight.Unlock()
 	sweepStale(now, cfg.slotTTL)
 
+	// Session affinity runs before tier ordering: a conversation must stay on
+	// the account holding its cached prefix even when a peer tier exists.
+	bindKey := ""
+	pinnedBusy := false
+	if cfg.SessionAffinity {
+		sweepBindings(now, cfg.affinityTTL)
+		if sessionID := sessionIdentity(req.Options); sessionID != "" {
+			providerKey := strings.ToLower(strings.TrimSpace(req.Provider))
+			if providerKey == "" {
+				providerKey = "mixed"
+			}
+			bindKey = providerKey + "::" + sessionID + "::" + strings.ToLower(strings.TrimSpace(req.Model))
+			if binding, ok := inflight.bindings[bindKey]; ok {
+				for _, candidate := range req.Candidates {
+					if candidate.ID != binding.authID {
+						continue
+					}
+					// Busy is transient: fail over for this request but keep the
+					// pin so the session returns once the slot frees.
+					if acquireSlot(candidate, limitFor(cfg, candidate), tierRotationKey(candidate), now) {
+						return okEnvelope(pluginapi.SchedulerPickResponse{AuthID: candidate.ID, Handled: true})
+					}
+					pinnedBusy = true
+					break
+				}
+			}
+		}
+	}
+
 	// Host sends every priority tier (scheduler_across_priorities) sorted by ID,
 	// not by priority. Reorder so a full high-priority credential falls through
 	// to the next tier instead of an unlimited lower-priority one jumping the queue.
@@ -372,16 +533,17 @@ func pickAuth(raw []byte) ([]byte, error) {
 			tiers[len(tiers)-1].candidates = append(tiers[len(tiers)-1].candidates, candidate)
 		}
 	}
+	// Only the top tier may create a pin. Binding a fallback would trap a
+	// session on a paid lower tier for the whole TTL even after the preferred
+	// credential frees up.
+	topPriority := req.Candidates[0].Priority
 
 	for _, tier := range tiers {
 		m := len(tier.candidates)
 		if m == 0 {
 			continue
 		}
-		rotKey := strconv.Itoa(tier.priority)
-		if len(tier.candidates) > 0 && strings.TrimSpace(tier.candidates[0].Provider) != "" {
-			rotKey = strings.TrimSpace(tier.candidates[0].Provider) + ":" + rotKey
-		}
+		rotKey := tierRotationKey(tier.candidates[0])
 		startIdx := 0
 		if cfg.rrProviders[strings.TrimSpace(tier.candidates[0].Provider)] {
 			if lastID, ok := inflight.lastPicked[rotKey]; ok && lastID != "" {
@@ -396,20 +558,13 @@ func pickAuth(raw []byte) ([]byte, error) {
 
 		for i := 0; i < m; i++ {
 			candidate := tier.candidates[(startIdx+i)%m]
-			limit := limitFor(cfg, candidate)
-			if limit <= 0 {
-				if inflight.lastPicked != nil {
-					inflight.lastPicked[rotKey] = candidate.ID
-				}
-				return okEnvelope(pluginapi.SchedulerPickResponse{AuthID: candidate.ID, Handled: true})
+			if !acquireSlot(candidate, limitFor(cfg, candidate), rotKey, now) {
+				continue
 			}
-			if int64(len(inflight.slots[candidate.ID])) < limit {
-				inflight.slots[candidate.ID] = append(inflight.slots[candidate.ID], now)
-				if inflight.lastPicked != nil {
-					inflight.lastPicked[rotKey] = candidate.ID
-				}
-				return okEnvelope(pluginapi.SchedulerPickResponse{AuthID: candidate.ID, Handled: true})
+			if bindKey != "" && !pinnedBusy && candidate.Priority == topPriority {
+				inflight.bindings[bindKey] = affinityBinding{authID: candidate.ID, at: now}
 			}
+			return okEnvelope(pluginapi.SchedulerPickResponse{AuthID: candidate.ID, Handled: true})
 		}
 	}
 	return okEnvelope(pluginapi.SchedulerPickResponse{
@@ -468,7 +623,7 @@ func loadedConfig() pluginConfig {
 	if cfg, ok := raw.(pluginConfig); ok {
 		return cfg
 	}
-	return pluginConfig{slotTTL: 30 * time.Minute}
+	return pluginConfig{slotTTL: 30 * time.Minute, affinityTTL: time.Hour}
 }
 
 func okEnvelope(v any) ([]byte, error) {
diff --git a/examples/plugin/cred-concurrency/go/main_test.go b/examples/plugin/cred-concurrency/go/main_test.go
index 3ba37964..28e9c19f 100644
--- a/examples/plugin/cred-concurrency/go/main_test.go
+++ b/examples/plugin/cred-concurrency/go/main_test.go
@@ -413,3 +413,193 @@ func TestConfigureRejectsNonPositiveSlotTTL(t *testing.T) {
 	// Restore a valid config so other tests are unaffected.
 	t.Cleanup(func() { currentConfig.Store(pluginConfig{slotTTL: 30 * time.Minute}) })
 }
+
+// seedAffinityConfig enables session affinity (and optionally round-robin).
+func seedAffinityConfig(t *testing.T, rrProviders map[string]bool) {
+	t.Helper()
+	currentConfig.Store(pluginConfig{
+		slotTTL:         30 * time.Minute,
+		rrProviders:     rrProviders,
+		affinityTTL:     time.Hour,
+		SessionAffinity: true,
+	})
+	t.Cleanup(func() { currentConfig.Store(pluginConfig{slotTTL: 30 * time.Minute}) })
+}
+
+// pickWithSession issues a scheduler.pick carrying a session identity header.
+func pickWithSession(t *testing.T, candidates, header, sessionID string) pluginapiPickResponse {
+	t.Helper()
+	body := map[string]any{
+		"provider":   "devin",
+		"model":      "claude-fable-5-1",
+		"candidates": json.RawMessage(candidates),
+		"options": map[string]any{
+			"headers": map[string][]string{header: {sessionID}},
+		},
+	}
+	rawReq, errMarshal := json.Marshal(body)
+	if errMarshal != nil {
+		t.Fatalf("marshal: %v", errMarshal)
+	}
+	raw, err := handleMethod("scheduler.pick", rawReq)
+	if err != nil {
+		t.Fatalf("pickAuth error: %v", err)
+	}
+	var env envelope
+	if err := json.Unmarshal(raw, &env); err != nil {
+		t.Fatalf("envelope: %v", err)
+	}
+	if !env.OK {
+		t.Fatalf("pick not ok: %s", raw)
+	}
+	var resp pluginapiPickResponse
+	if err := json.Unmarshal(env.Result, &resp); err != nil {
+		t.Fatalf("result: %v", err)
+	}
+	return resp
+}
+
+func TestSessionAffinityPinsCredentialAcrossTurns(t *testing.T) {
+	// Round-robin would alternate cle<->eps; affinity must keep one session on
+	// the credential holding its cached prefix.
+	seedAffinityConfig(t, map[string]bool{"devin": true})
+	resetInflight(t)
+	cands := `[
+		{"ID":"01-cle","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}},
+		{"ID":"02-eps","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}}
+	]`
+
+	first := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "session-a")
+	usage(t, first.AuthID)
+
+	for i := 0; i < 3; i++ {
+		got := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "session-a")
+		if got.AuthID != first.AuthID {
+			t.Fatalf("turn %d picked %s, want pinned %s", i+2, got.AuthID, first.AuthID)
+		}
+		usage(t, got.AuthID)
+	}
+
+	// A different session is free to land on the other credential.
+	other := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "session-b")
+	if other.AuthID == first.AuthID {
+		t.Fatalf("second session also pinned to %s; affinity over-applied", other.AuthID)
+	}
+}
+
+func TestSessionAffinitySubagentInheritsParent(t *testing.T) {
+	seedAffinityConfig(t, map[string]bool{"devin": true})
+	resetInflight(t)
+	cands := `[
+		{"ID":"01-cle","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}},
+		{"ID":"02-eps","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}}
+	]`
+
+	parent := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "root-task")
+	usage(t, parent.AuthID)
+
+	// Subagent carries its own session id but points at the parent.
+	sub := pickWithSession(t, cands, "X-Parent-Session-Id", "root-task")
+	if sub.AuthID != parent.AuthID {
+		t.Fatalf("subagent picked %s, want parent's %s", sub.AuthID, parent.AuthID)
+	}
+
+	// ":agent:" suffixed ids fold onto the parent too.
+	usage(t, sub.AuthID)
+	sub2 := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "root-task:agent:worker-1")
+	if sub2.AuthID != parent.AuthID {
+		t.Fatalf("agent-suffixed session picked %s, want parent's %s", sub2.AuthID, parent.AuthID)
+	}
+}
+
+func TestSessionAffinityKeepsPinWhenBoundCredentialBusy(t *testing.T) {
+	seedAffinityConfig(t, nil)
+	resetInflight(t)
+	cands := `[
+		{"ID":"01-cle","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}},
+		{"ID":"02-eps","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}}
+	]`
+
+	first := pickWithSession(t, cands, "X-Session-ID", "session-busy")
+	// Leave the slot held so the pinned credential is at its cap.
+	spill := pickWithSession(t, cands, "X-Session-ID", "session-busy")
+	if spill.AuthID == first.AuthID {
+		t.Fatalf("expected spill to a peer while %s is busy, got %s", first.AuthID, spill.AuthID)
+	}
+	// The pin must survive the transient spill: once the original frees up the
+	// session returns to it instead of drifting permanently.
+	usage(t, first.AuthID)
+	usage(t, spill.AuthID)
+	back := pickWithSession(t, cands, "X-Session-ID", "session-busy")
+	if back.AuthID != first.AuthID {
+		t.Fatalf("after release picked %s, want the original pin %s", back.AuthID, first.AuthID)
+	}
+}
+
+func TestSessionAffinityOffKeepsRoundRobin(t *testing.T) {
+	// Default config has affinity disabled: behaviour must match the old RR path.
+	seedConfig(t, map[string]bool{"devin": true})
+	resetInflight(t)
+	cands := `[
+		{"ID":"01-cle","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}},
+		{"ID":"02-eps","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}}
+	]`
+
+	first := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "session-rr")
+	usage(t, first.AuthID)
+	second := pickWithSession(t, cands, "X-Claude-Code-Session-Id", "session-rr")
+	if second.AuthID == first.AuthID {
+		t.Fatalf("affinity disabled but picks stayed on %s; RR broken", first.AuthID)
+	}
+}
+
+func TestSweepBindingsDropsExpiredPins(t *testing.T) {
+	resetInflight(t)
+	now := time.Now()
+	inflight.Lock()
+	inflight.bindings["k"] = affinityBinding{authID: "x", at: now.Add(-2 * time.Hour)}
+	inflight.bindings["fresh"] = affinityBinding{authID: "y", at: now}
+	inflight.Unlock()
+
+	sweepBindings(now, time.Hour)
+
+	inflight.Lock()
+	defer inflight.Unlock()
+	if _, ok := inflight.bindings["k"]; ok {
+		t.Fatalf("expired binding survived the sweep")
+	}
+	if _, ok := inflight.bindings["fresh"]; !ok {
+		t.Fatalf("live binding was dropped")
+	}
+}
+
+func TestSessionAffinityDoesNotBindFallbackTier(t *testing.T) {
+	// A session that starts while the preferred tier is exhausted must not be
+	// pinned to the paid fallback; it should return to the top tier once free.
+	seedAffinityConfig(t, nil)
+	resetInflight(t)
+	cands := `[
+		{"ID":"01-cle","Provider":"devin","Priority":20,"Metadata":{"max-concurrent":1}},
+		{"ID":"glm","Provider":"devin","Priority":14,"Metadata":{"max-concurrent":4}}
+	]`
+
+	// Hold the top tier busy with another session.
+	blocker := pickWithSession(t, cands, "X-Session-ID", "blocker")
+	if blocker.AuthID != "01-cle" {
+		t.Fatalf("blocker = %s, want 01-cle", blocker.AuthID)
+	}
+
+	// Our session starts during the outage and lands on the fallback.
+	first := pickWithSession(t, cands, "X-Session-ID", "late-session")
+	if first.AuthID != "glm" {
+		t.Fatalf("late session = %s, want fallback glm", first.AuthID)
+	}
+	usage(t, first.AuthID)
+
+	// Preferred tier frees up: the session must go back, not stay on the pin.
+	usage(t, blocker.AuthID)
+	next := pickWithSession(t, cands, "X-Session-ID", "late-session")
+	if next.AuthID != "01-cle" {
+		t.Fatalf("after recovery picked %s, want top tier 01-cle", next.AuthID)
+	}
+}
